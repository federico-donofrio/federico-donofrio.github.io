---
const { title = "Federico D'Onofrio" } = Astro.props;
---

<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>

  <body>
    <div class="site">

      <aside>
        <div class="name">
          Federico<br />
          D'Onofrio
        </div>

        <nav>
          <a href={import.meta.env.BASE_URL}>Home</a>
<a href={`${import.meta.env.BASE_URL}research`}>Research</a>
<a href={`${import.meta.env.BASE_URL}publications`}>Publications</a>
<a href={`${import.meta.env.BASE_URL}people`}>People</a>
<a href={`${import.meta.env.BASE_URL}cv`}>CV</a>
        </nav>
      </aside>

      <main>
        <slot />
      </main>

    </div>
  </body>
</html>
